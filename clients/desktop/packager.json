{
  "$schema": "https://raw.githubusercontent.com/crabnebula-dev/cargo-packager/main/bindings/packager/nodejs/schema.json",
  "name": "akiron-mux-desktop",
  "productName": "AkironMux",
  "version": "1.15.0",
  "identifier": "dev.akiron.mux",
  "description": "Unified Claude Code and Codex session workspace",
  "homepage": "https://github.com/akiron-ai/akiron-mux",
  "authors": ["AkironMux contributors"],
  "publisher": "AkironMux contributors",
  "copyright": "Copyright AkironMux contributors",
  "licenseFile": "../../LICENSE",
  "category": "DeveloperTool",
  "beforePackagingCommand": "cargo build --locked --release -p akmux-desktop",
  "binariesDir": "target/release",
  "binaries": [
    {
      "path": "akmux-desktop",
      "main": true
    }
  ],
  "icons": [
    "icons/32x32.png",
    "icons/128x128.png",
    "icons/128x128@2x.png",
    "icons/icon.png",
    "icons/icon.ico"
  ],
  "outDir": "dist",
  "linux": {
    "generateDesktopEntry": true
  },
  "deb": {
    "depends": [
      "libgtk-3-0",
      "libayatana-appindicator3-1 | libappindicator3-1",
      "libxdo3",
      "libxkbcommon0",
      "libfontconfig1",
      "libvulkan1"
    ],
    "section": "utils",
    "priority": "optional"
  },
  "windows": {
    "allowDowngrades": false,
    "digestAlgorithm": "sha256"
  },
  "macos": {
    "minimumSystemVersion": "12.0"
  }
}
