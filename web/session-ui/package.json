{
  "name": "akiron-mux-webui",
  "private": true,
  "version": "1.14.4",
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test:e2e": "playwright test",
    "desktop:verify": "node scripts/verify-desktop-config.mjs",
    "dev": "vite",
    "desktop:dev": "cargo tauri dev",
    "desktop:build": "cargo tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis",
    "desktop:build:linux": "cargo tauri build --bundles deb"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "1.61.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
